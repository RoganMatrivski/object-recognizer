<Window x:Class="ObjectRecognizerApp.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture from Camera" Height="450" Width="600" WindowStartupLocation="CenterOwner"
        Closed="Window_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Camera Preview Placeholder / Image -->
        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1" Background="Black" Margin="0,0,0,10">
            <Image x:Name="ImgPreview" Stretch="Uniform"/>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnCapture" Content="Capture Snapshot" Click="BtnCapture_Click" Width="140" Height="35" FontSize="14" Margin="0,0,10,0"/>
            <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Width="80" Height="35" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
